{
  "name": "AIOStore",
  "subtitle": "Every source in one place.",
  "repository": "zKevinLy/aiostore",
  "branch": "main",
  "sources": [
    {
      "id": "spotube",
      "type": "github",
      "name": "Spotube",
      "description": "Open-source, plugin-powered music streaming app. Official iOS builds, generated from GitHub releases.",
      "homepage": "https://spotube.cc",
      "repo": "team-spotube/spotube",
      "tagPattern": "^v(\\d+\\.\\d+\\.\\d+)$",
      "app": {
        "name": "Spotube",
        "bundleIdentifier": "oss.krtirtho.spotube",
        "developerName": "Spotube",
        "subtitle": "Open-source music streaming",
        "category": "entertainment"
      },
      "assets": [
        {
          "match": "^Spotube-[iI][oO][sS]\\.ipa$"
        }
      ]
    },
    {
      "id": "nuvio",
      "type": "external",
      "name": "Nuvio",
      "description": "Free, open-source media app. Official iOS builds, published by the Nuvio developers.",
      "homepage": "https://github.com/NuvioMedia/NuvioMobile",
      "url": "https://raw.githubusercontent.com/NuvioMedia/NuvioMobile/refs/heads/cmp-rewrite/store.json"
    },
    {
      "id": "ytkace",
      "type": "github",
      "name": "YTKACE",
      "description": "YouTube enhancer for iOS with SponsorBlock, background playback and downloads. Generated from GitHub releases.",
      "repo": "itzzace/ytkace",
      "app": {
        "name": "YTKACE",
        "bundleIdentifier": "com.google.ios.youtube",
        "developerName": "itzzace",
        "iconURL": "https://www.google.com/s2/favicons?sz=256&domain=youtube.com",
        "subtitle": "YouTube enhancer and downloader for iOS",
        "category": "entertainment"
      },
      "assets": [
        {
          "match": "^YTKACE_.+_YouTube_[0-9.]+\\.ipa$",
          "minOSVersion": "17.0"
        }
      ]
    }
  ]
}
